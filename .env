# Pakai profil Chrome yang sudah pernah login FASIH
USE_CHROME_PROFILE=true

# Buka chrome://version pada profil yang sudah login.
# CHROME_USER_DATA_DIR = parent dari Profile Path.
# CHROME_PROFILE_NAME = nama folder terakhir pada Profile Path.
CHROME_USER_DATA_DIR=C:\Users\Dell\AppData\Local\Google\Chrome\User Data
CHROME_PROFILE_NAME=Profile 9

# "copy" disarankan: profil asli disalin sekali ke .auth/chrome_fasih_profile.
# "direct" memakai profil asli dan mengharuskan semua Chrome ditutup setiap run.
CHROME_PROFILE_MODE=copy

# true hanya saat ingin menyalin ulang profil asli yang lebih baru.
# Setelah berhasil, ubah kembali menjadi false.
FORCE_PROFILE_COPY=true

# Gunakan Google Chrome yang terpasang.
BROWSER_CHANNEL=chrome
CHROME_EXECUTABLE_PATH=

# Profil persisten dijalankan dengan browser terlihat.
HEADLESS=false
PLAYWRIGHT_SLOW_MO=100

# Opsional. Hanya dipakai jika session SSO pada profil ternyata sudah kedaluwarsa.
username=nunungs
password=565altec
use_otp=no
